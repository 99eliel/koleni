rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isImage(maxBytes) {
      return request.resource != null
        && request.resource.size < maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    function isPdf(maxBytes) {
      return request.resource != null
        && request.resource.size < maxBytes
        && request.resource.contentType == 'application/pdf';
    }

    function isLogoAsset() {
      return isImage(5 * 1024 * 1024) || isPdf(15 * 1024 * 1024);
    }

    match /garments/{garmentId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isImage(10 * 1024 * 1024);
      allow delete: if isSignedIn();
    }

    match /logo-assets/{hash}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isLogoAsset();
      allow delete: if isSignedIn();
    }

    match /logos/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && isImage(5 * 1024 * 1024);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /logo-originals/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && isPdf(15 * 1024 * 1024);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /final-renders/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && isImage(10 * 1024 * 1024);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
